<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      alignment="CENTER"
      spacing="12"
      style="-fx-background-color: #f4f6fb;">

    <padding>
        <Insets top="48" right="48" bottom="48" left="48"/>
    </padding>

    <Label text="Admin Home"
           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1f3a93;"/>
    <Label text="Server connection established."
           style="-fx-font-size: 16px; -fx-text-fill: #667085;"/>
</VBox>
