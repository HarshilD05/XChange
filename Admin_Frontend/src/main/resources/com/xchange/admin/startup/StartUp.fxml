<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.xchange.admin.startup.StartUpController"
      alignment="CENTER"
      spacing="18"
      styleClass="startup-page">

    <padding>
        <Insets top="48" right="48" bottom="48" left="48"/>
    </padding>

    <VBox alignment="CENTER" spacing="8">
        <Label text="XChange" styleClass="brand-title"/>
        <Label text="Admin Server Connection" styleClass="page-title"/>
    </VBox>

    <VBox spacing="8" maxWidth="360">
        <Label text="Server address" styleClass="field-label"/>
        <TextField fx:id="serverAddressField"
                   promptText="IP address or hostname"
                   styleClass="text-field"/>
    </VBox>

    <VBox spacing="8" maxWidth="360">
        <Label text="Port" styleClass="field-label"/>
        <TextField fx:id="portField"
                   promptText="8080"
                   styleClass="text-field"/>
    </VBox>

    <HBox alignment="CENTER" spacing="12" maxWidth="360">
        <ProgressIndicator fx:id="connectionProgress"
                           prefWidth="28"
                           prefHeight="28"/>
        <Button fx:id="connectButton"
                text="Connect"
                onAction="#onConnect"
                defaultButton="true"
                maxWidth="Infinity"
                HBox.hgrow="ALWAYS"
                styleClass="primary-button"/>
    </HBox>

    <Label fx:id="statusLabel"
           text="Enter the XChange main server address."
           wrapText="true"
           textAlignment="CENTER"
           maxWidth="360"
           styleClass="status-label"/>
</VBox>
